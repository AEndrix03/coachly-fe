        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"workout_id\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'open', \"payload\" TEXT NULL, \"started_at\" INTEGER NULL, \"completed_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
