    {
      "name": "catalog_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_exercises\" (\"id\" TEXT NOT NULL, \"code\" TEXT NOT NULL DEFAULT '', \"difficulty_level\" TEXT NULL, \"mechanics_type\" TEXT NULL, \"force_type\" TEXT NULL, \"unilateral\" INTEGER NOT NULL DEFAULT 0 CHECK (\"unilateral\" IN (0, 1)), \"bodyweight\" INTEGER NOT NULL DEFAULT 0 CHECK (\"bodyweight\" IN (0, 1)), \"exercise_kind\" TEXT NULL, \"catalog_status\" TEXT NULL, \"payload\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "localized_texts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"localized_texts\" (\"entity_type\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"field\" TEXT NOT NULL, \"locale\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"entity_type\", \"entity_id\", \"field\", \"locale\"));"
        }
      ]
    },
    {
      "name": "exercise_muscles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_muscles\" (\"exercise_id\" TEXT NOT NULL, \"muscle_id\" TEXT NOT NULL, \"muscle_code\" TEXT NOT NULL DEFAULT '', \"involvement\" TEXT NULL, PRIMARY KEY (\"exercise_id\", \"muscle_id\"));"
        }
      ]
    },
    {
      "name": "exercise_equipments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_equipments\" (\"exercise_id\" TEXT NOT NULL, \"equipment_id\" TEXT NOT NULL, \"equipment_code\" TEXT NOT NULL DEFAULT '', \"required\" INTEGER NOT NULL DEFAULT 1 CHECK (\"required\" IN (0, 1)), PRIMARY KEY (\"exercise_id\", \"equipment_id\"));"
        }
      ]
    },
    {
      "name": "exercise_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_categories\" (\"exercise_id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"category_code\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"exercise_id\", \"category_id\"));"
        }
      ]
    },
    {
      "name": "catalog_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_meta\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"version\" INTEGER NOT NULL DEFAULT 0, \"applied_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "custom_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_exercises\" (\"id\" TEXT NOT NULL, \"difficulty_level\" TEXT NULL, \"mechanics_type\" TEXT NULL, \"force_type\" TEXT NULL, \"unilateral\" INTEGER NOT NULL DEFAULT 0 CHECK (\"unilateral\" IN (0, 1)), \"bodyweight\" INTEGER NOT NULL DEFAULT 0 CHECK (\"bodyweight\" IN (0, 1)), \"payload\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "workouts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workouts\" (\"id\" TEXT NOT NULL, \"origin\" TEXT CHECK (origin IN ('user','assigned')) NOT NULL DEFAULT 'user', \"source_program_id\" TEXT NULL, \"goal\" TEXT NULL, \"duration_minutes\" INTEGER NOT NULL DEFAULT 0, \"sessions_count\" INTEGER NOT NULL DEFAULT 0, \"progress\" REAL NOT NULL DEFAULT 0.0, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"dirty\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dirty\" IN (0, 1)), \"payload\" TEXT NULL, \"last_used\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
