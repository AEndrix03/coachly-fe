          "sql": "CREATE TABLE IF NOT EXISTS \"workout_snapshots\" (\"workout_id\" TEXT NOT NULL, \"command_json\" TEXT NOT NULL, \"source_updated_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"workout_id\"));"
        }
